# Provider mode: "stub" for fake data (default, used in dev/CI/tests), "live" for real providers.
PROVIDER_MODE=stub

# Stub only: walk the staleness ladder. Comma-separated pot:state, where pot is
# Base, Medium, Degen or all, and state is hours old, failed or closed.
# e.g. Degen:2 (amber) · Degen:failed (red) · all:closed. Leave empty for fresh.
STUB_STALENESS=

# Postgres connection. Hosted, in every environment — Neon or Supabase free
# tier (never Render's free Postgres, it expires after 30 days). Development
# uses its own database on the same host, not a local server.
# Neon: Dashboard → Connection string → include ?sslmode=require
DATABASE_URL=

PORT=3001

# Supabase Auth — emailed magic links for now (Google later). Add the web app's
# origin, e.g. http://localhost:5173, under Authentication → URL Configuration →
# Redirect URLs, or links land in the wrong place. The API verifies tokens against the
# project's public signing keys, so it needs the project URL and no secret.
SUPABASE_URL=

# Web app (read by Vite; safe to ship — the publishable key is public by design,
# which is why every table has Row Level Security switched on).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Alpha Vantage — market-data fallback for daily closes (Phase 2). Free key.
AV_ACCESS_KEY=

# Seals provider keys at rest. Required for PROVIDER_MODE=t212. In production
# it lives only in Render. Make one with: pnpm --filter api master-key
MASTER_KEY=
MASTER_KEY_VERSION=1
LOG_LEVEL=info
# Production only: serve the built web app from the API's origin (API under /api).
# WEB_DIST_DIR=../web/dist
# Shared secret for POST /jobs/refresh (the scheduler). Render + private.job_settings only.
JOB_SECRET=

# Trading 212 practice account — developer verification only (Phase 2 task 1).
# The server never reads these; users' keys are sealed per user in Postgres.
# T212_API_KEY=
# T212_API_SECRET=

# Kraken — do not fill in until Phase 4. Never commit real values.
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=
