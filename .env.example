# Copy to apps/api/.env for local development. Nothing here needs a value to run
# the app in stub mode (fake data, no network, no keys): leave everything blank.
# Never commit a real value.

# --- Server ---

# "stub" (default; fake data, used in dev, CI and tests) or "t212" (real
# Trading 212 practice account, plus Kraken read-only; needs MASTER_KEY).
PROVIDER_MODE=stub

# Port the API listens on.
PORT=3001

# Log level for the pino logger (trace, debug, info, warn, error).
LOG_LEVEL=info

# Only "demo" (the Trading 212 practice environment) is accepted.
# T212_ENV=demo

# Production only: directory of the built web app, so the API serves it from
# the same origin (API under /api). Relative to apps/api.
# WEB_DIST_DIR=../web/dist

# Production only: redirect app pages asked for on any other host to this host.
# CANONICAL_HOST=

# Stub mode only: walk the staleness ladder. Comma-separated pot:state, where pot
# is Base, Medium, Degen or all, and state is hours old, failed or closed.
# For example Degen:2 (amber), Degen:failed (red), all:closed. Empty means fresh.
STUB_STALENESS=

# --- Database and auth (needed for the full app, not for stub-mode tests) ---

# Postgres connection string for a hosted database (Supabase, session pooler).
# Include ?sslmode=require where the host needs it.
DATABASE_URL=

# Supabase project URL. The API verifies sign-in tokens against the project's
# public signing keys, so it needs the URL and no secret.
SUPABASE_URL=

# Read by the web app (Vite) at build time. Safe to ship: the publishable key is
# public by design, which is why every table has Row Level Security switched on.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dev server only: where the web dev server proxies API requests.
# VITE_API_ORIGIN=http://localhost:3001

# Local development only: lets `pnpm --filter api sign-in-link` make a one-time
# sign-in link without sending an email. Full admin access to the Supabase
# project, so never put it on a host, in the web app or in git.
# SUPABASE_SERVICE_ROLE_KEY=

# Local development only: origin the sign-in-link tool redirects to.
# DEV_WEB_ORIGIN=http://localhost:5173

# --- Secrets handling ---

# Seals provider keys at rest (AES-256-GCM). Required for PROVIDER_MODE=t212.
# Generate one with: pnpm --filter api master-key
MASTER_KEY=

# Version stamped on new seals, used when rotating MASTER_KEY.
MASTER_KEY_VERSION=1

# While rotating MASTER_KEY: the old key and its version, so old values still
# open until `pnpm --filter api reseal-keys` has re-sealed them.
# MASTER_KEY_PREVIOUS=
# MASTER_KEY_PREVIOUS_VERSION=

# Shared secret (at least 32 characters) for POST /jobs/refresh, the scheduler's
# door. Must match the private.job_settings row that pg_cron reads.
JOB_SECRET=

# --- Market data and news (all optional; without them Pip uses the other sources) ---

# Alpha Vantage free key: market-data fallback for daily closes, plus news.
AV_ACCESS_KEY=

# CoinGecko Demo key: crypto prices in pounds. Without it, Kraken's public prices only.
COINGECKO_KEY=

# Marketaux free key: news. Without it, the other news sources only.
MARKETAUX_API=

# --- Wording (optional) ---

# "stub" (default; canned words, no network, always used in CI) or "groq".
LLM_MODE=stub

# Needed for LLM_MODE=groq.
GROQ_API_KEY=

# Model used when LLM_MODE=groq. Defaults to openai/gpt-oss-120b.
# LLM_MODEL=

# --- Notifications (optional) ---

# "stub" (default; records pushes and emails in memory) or "live", which needs
# the five values below.
NOTIFY_MODE=stub

# Web Push VAPID key pair (public and private), and a mailto: address or https://
# URL identifying the sender.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Resend API key and the From address for Pip's emails.
RESEND_KEY=
EMAIL_FROM=
