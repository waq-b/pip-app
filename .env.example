# Provider mode: "stub" for fake data (default, used in dev/CI/tests), "live" for real providers.
PROVIDER_MODE=stub

# Postgres connection. Local: `docker compose up -d postgres` serves exactly this
# URL. Prod: Neon or Supabase free tier (never Render's free Postgres — it
# expires after 30 days).
DATABASE_URL=postgres://pip:pip@localhost:5432/pip_dev

PORT=3001

# Auth.js — Google is the only sign-in provider, and access is limited to the
# allowlist table in Postgres. Never commit real values.
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Where Auth.js thinks it lives. In dev, Vite proxies /auth to the api so the
# session cookie stays same-origin.
AUTH_URL=http://localhost:5173/auth
# From console.cloud.google.com → APIs & Services → Credentials.
# Authorised redirect URI: {AUTH_URL}/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Trading 212 — do not fill in until Phase 2/3. Never commit real values.
# T212_ENV=demo
# T212_API_KEY=

# Kraken — do not fill in until Phase 4. Never commit real values.
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=
