# Provider mode: "stub" for fake data (default, used in dev/CI/tests), "live" for real providers.
PROVIDER_MODE=stub

# Postgres connection. Local: Docker Postgres. Prod: Neon or Supabase free tier
# (never Render's free Postgres — it expires after 30 days).
DATABASE_URL=postgres://localhost:5432/finance_app_dev

PORT=3001

# Trading 212 — do not fill in until Phase 2/3. Never commit real values.
# T212_ENV=demo
# T212_API_KEY=

# Kraken — do not fill in until Phase 4. Never commit real values.
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=
