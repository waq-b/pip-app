{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import tsx dist/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "allowlist": "tsx --env-file-if-exists=.env src/auth/cli.ts",
    "master-key": "tsx src/crypto/master-key-cli.ts",
    "reseal-keys": "tsx --env-file-if-exists=.env src/crypto/reseal-cli.ts",
    "sign-in-link": "tsx --env-file-if-exists=.env src/dev/sign-in-link.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@finance-app/shared": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.1.0",
    "jose": "^6.2.12",
    "pg": "^8.13.1",
    "tsx": "^4.23.13",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
